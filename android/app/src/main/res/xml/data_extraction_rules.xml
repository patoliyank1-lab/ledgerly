<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules — Android 12+ (data extraction rules).
  Financial data is sensitive: backup is handled manually by the user
  via the in-app Export / Backup feature (Phase 5).
  We disable Android Auto-Backup to prevent silent cloud uploads.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device-to-device transfers when user sets up a new phone -->
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

